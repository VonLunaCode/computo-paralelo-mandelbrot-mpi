# Copia este archivo a "hosts" (sin .example) y ajusta IPs y nucleos.
# REGLA: la PRIMERA linea es el maestro (Vivobook) con slots=1: ahi vive el rank 0 y nada mas.
# Pon en slots el numero de NUCLEOS FISICOS de cada laptop trabajadora (ver `lscpu`, "Core(s) per socket").
192.168.50.11 slots=1     # Vivobook (maestro)
192.168.50.12 slots=6     # Laptop con GPU (trabajador)  <- ajusta
192.168.50.13 slots=4     # Tercera laptop (trabajador)   <- ajusta
